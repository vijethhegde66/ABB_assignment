# Copy to .env and replace every "replace-me" value. Never commit .env.

# --- Alarm Management API (simulator) ---------------------------------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me
# Simulator accepts these tokens (comma separated); keep in sync with ALARM_API_TOKEN
SIM_API_TOKENS=replace-me
SIM_SEED=42
# SIM_DATA_END=2026-10-12T00:00:00Z     # default: now

# --- Candidate MCP server (Alarm Management) --------------------------------
MCP_SERVER_URL=http://alarm-mcp:9000/mcp
MCP_AUTH_TOKEN=replace-me
MCP_TOOL_TIMEOUT_SECONDS=45
# connector timeouts / retries used by the MCP server
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=3

# --- Secondary MCP server (work orders, write operations need approval) -----
WORK_ORDERS_MCP_URL=http://work-orders-mcp:9100/mcp
WORK_ORDERS_MCP_TOKEN=replace-me
WO_MCP_SIGNING_KEY=replace-me

# --- RAG ----------------------------------------------------------------------
DOCUMENT_PATH=./rag/documents
RAG_INDEX_PATH=./var/rag-index
EMBEDDING_PROVIDER=hashing            # hashing | sentence-transformers
VECTOR_STORE_URL=file://./var/rag-index

# --- LLM (optional; deterministic grounded composer when "none") --------------
LLM_PROVIDER=none                     # none | anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=replace-me

# --- Copilot / GUI --------------------------------------------------------------
COPILOT_PORT=8080
COPILOT_DEFAULT_LOOKBACK_DAYS=90
ENABLE_DEMO_CONTROLS=false            # fault-injection panel (test harness only)
